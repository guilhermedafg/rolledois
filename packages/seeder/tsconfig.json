{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "include": ["./lib/**/*"],
    "compilerOptions": {
        "lib": ["ESNext"],
        "strict": true,
        "noEmit": true,
        "checkJs": false,
        "forceConsistentCasingInFileNames": true,
        "allowImportingTsExtensions": true,
        "moduleResolution": "bundler"
    }
}
